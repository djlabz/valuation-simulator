{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text"],
  "coverageAnalysis": "all",
  "mutate": [
    "packages/shared/src/**/*.ts",
    "!packages/shared/src/**/*.test.ts"
  ],
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
