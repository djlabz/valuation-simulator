# Dependências
node_modules/
.pnp/
.pnp.js

# Build e empacotamento
dist/
out/
build/
release/
*.tsbuildinfo

# Electron: bundle do main, empacotamento e cache de download do binário
dist-electron/
dist_electron/
out-electron/
release-builds/
app.asar
*.asar
.electron/
.electron-gyp/
electron-builder.env

# Ingestão: conteúdo bruto fica fora do versionamento (RF-119, D-015, D-042)
/ingest/*
!/ingest/.gitkeep

# Banco local: o SQLite é estado de máquina, não fonte de verdade (D-001)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/dados/

# Ambiente e segredos
.env
.env.*
!.env.example

# Logs e cobertura
*.log
npm-debug.log*
coverage/
.nyc_output/

# Editor e sistema operacional
.DS_Store
Thumbs.db
# WSL: metadado de origem que o Windows cria em arquivo baixado
*Zone.Identifier
.idea/
.vscode/*
!.vscode/extensions.json

# Resíduo de ferramenta local
#
# A pasta .claude fica fora inteira, e não só o settings.local.json, por causa de um
# caso concreto do Passo 1: apareceu um worktree do git em .claude/worktrees/<nome>,
# criado por ferramenta. Worktree é uma cópia do repositório dentro do repositório,
# então com apenas o settings.local.json ignorado bastava um git add -A distraído para
# engolir a árvore inteira duplicada.
#
# A exceção é .claude/skills, que não é resíduo: é artefato do projeto, versionado e
# revisado por commit (RNF-011, D-038). O padrão exclui o conteúdo de .claude em vez da
# pasta, porque o git não reinclui nada dentro de um diretório já excluído.
/.claude/*
!/.claude/skills/

# Saída do Stryker, gerada a cada rodada de mutation testing (D-049)
.stryker-tmp
reports
